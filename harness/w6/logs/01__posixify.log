import click

def _posixify(name: str) -> str:
    return "-".join(name.split()).lower()

def test_posixify():
    assert _posixify("Hello World") == "hello-world"
    assert _posixify("  This   is a Test  ") == "this-is-a-test"
    assert _posixify("NoSpaces") == "nospaces"
    assert _posixify("") == ""
    assert _posixify("Already-posix") == "already-posix"

if __name__ == "__main__":
    import pytest
    pytest.main([__file__])
