```python
import click
from click.testing import CliRunner
from contextlib import contextmanager
from typing import Iterator

class TestableFormatter:
    def __init__(self, initial_indent: str, subsequent_indent: str):
        self.initial_indent = initial_indent
        self.subsequent_indent = subsequent_indent

    @contextmanager
    def extra_indent(self, indent: str) -> Iterator[None]:
        old_initial_indent = self.initial_indent
        old_subsequent_indent = self.subsequent_indent
        self.initial_indent += indent
        self.subsequent_indent += indent

        try:
            yield
        finally:
            self.initial_indent = old_initial_indent
            self.subsequent_indent = old_subsequent_indent

def test_extra_indent():
    formatter = TestableFormatter('', '')
    runner = CliRunner()

    with formatter.extra_indent('  '):
        result = runner.invoke(click.echo, ['test'], obj=formatter)

    assert formatter.initial_indent == '  '
    assert formatter.subsequent_indent == '  '
    assert result.output == '  test\n'

    # Check that the original indent was restored
    assert formatter.initial_indent == ''
    assert formatter.subsequent_indent == ''

if __name__ == '__main__':
    test_extra_indent()
```

This test case uses the `click` library's `CliRunner` to simulate the context in which the `extra_indent` context manager might be used. It checks that the `initial_indent` and `subsequent_indent` attributes are correctly modified and restored within the context manager.

