import os
import sys
from pathlib import Path
from unittest.mock import patch

import pytest

from your_module import get_app_dir, _posixify  # Adjust the import according to your actual module structure

@pytest.fixture
def home_dir(tmp_path):
    return tmp_path / 'home'

@pytest.fixture
def app_name():
    return "Foo Bar"

def test_get_app_dir_windows_roaming(home_dir):
    with patch.dict(os.environ, {"APPDATA": str(home_dir)}):
        result = get_app_dir("Foo Bar", roaming=True, force_posix=False)
        assert result == str(home_dir / "Foo Bar")

def test_get_app_dir_windows_not_roaming(home_dir):
    with patch.dict(os.environ, {"LOCALAPPDATA": str(home_dir)}):
        result = get_app_dir("Foo Bar", roaming=False, force_posix=False)
        assert result == str(home_dir / "Local\Foo Bar")

def test_get_app_dir_posix_force_posix(home_dir):
    with patch.dict(os.environ, {"HOME": str(home_dir)}):
        result = get_app_dir("Foo Bar", roaming=False, force_posix=True)
        assert result == str(home_dir / ".foo-bar")

def test_get_app_dir_darwin(home_dir):
    with patch("sys.platform", "darwin"), patch.dict(os.environ, {"HOME": str(home_dir)}):
        result = get_app_dir("Foo Bar", roaming=False, force_posix=False)
        assert result == str(home_dir / "Library/Application Support/Foo Bar")

def test_get_app_dir_unix(home_dir):
    with patch("sys.platform", "linux"), patch.dict(os.environ, {"HOME": str(home_dir)}):
        result = get_app_dir("Foo Bar", roaming=False, force_posix=False)
        assert result == str(home_dir / ".config/foo-bar")

def test_get_app_dir_unix_force_posix(home_dir):
    with patch("sys.platform", "linux"), patch.dict(os.environ, {"HOME": str(home_dir)}):
        result = get_app_dir("Foo Bar", roaming=False, force_posix=True)
        assert result == str(home_dir / ".foo-bar")

def _posixify(app_name: str) -> str:
    return app_name.replace(" ", "-")

# Assuming your_module is the module where get_app_dir is defined
if __name__ == "__main__":
    pytest.main([__file__])
