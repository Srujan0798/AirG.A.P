    # Call the callback function
    callback = confirmation_option.callback
    callback(ctx, param, value)

    # Check if ctx.abort was called
    assert ctx.abort.called

    # Check if default param_decls is set
    result = confirmation_option()
    assert result.param_decls == ("--yes",)

    # Check if default kwargs are set
    result = confirmation_option()
    assert result.is_flag is True
    assert result.callback == confirmation_option.callback
    assert result.expose_value is False
    assert result.prompt == _("Do you want to continue?")
    assert result.help == _("Confirm the action without prompting.")
