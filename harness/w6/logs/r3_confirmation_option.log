from click.decorators import confirmation_option
from click.core import Context, Parameter, option

def test_confirmation_option():
    # Create a mock context
    mock_context = Context(None)
    
    # Create a mock parameter
    mock_parameter = Parameter("test_param")
    
    # Call the callback with value=False
    callback = confirmation_option()(lambda ctx, param, value: None).callback
    callback(mock_context, mock_parameter, False)
    
    # Check if ctx.abort() was called
    assert mock_context.abort.called
    
    # Call the callback with value=True
    callback(mock_context, mock_parameter, True)
    
    # Check if ctx.abort() was not called
    assert not mock_context.abort.called
    
    # Check if default param_decls is set
    result = confirmation_option()()
    assert result.param_decls == ("--yes",)
    
    # Check if kwargs are set correctly
    result = confirmation_option()(lambda ctx, param, value: None)
    assert result.is_flag is True
    assert result.callback is not None
    assert result.expose_value is False
    assert result.prompt == "Do you want to continue?"
    assert result.help == "Confirm the action without prompting."
```
