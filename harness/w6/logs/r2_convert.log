from click.types import FuncParamType
from click.exceptions import BadParameter

def test_convert_with_none_value():
    func_type = FuncParamType(lambda value: value)
    result = func_type.convert(None, None, None)
    assert result is None

def test_convert_with_string_value():
    func_type = FuncParamType(lambda value: value.upper())
    result = func_type.convert("hello", None, None)
    assert result == "HELLO"

def test_convert_with_non_string_value():
    func_type = FuncParamType(lambda value: value * 2)
    result = func_type.convert(5, None, None)
    assert result == 10

def test_convert_with_failure():
    func_type = FuncParamType(lambda value: int(value))
    with pytest.raises(BadParameter) as exc_info:
        func_type.convert("not a number", None, None)
    assert "not a number" in exc_info.value.message
