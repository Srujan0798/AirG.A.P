from click.utils import make_input_stream
import io
import pytest

def test_make_input_stream_with_string_input():
    input_str = "Hello, World!"
    charset = "utf-8"
    result = make_input_stream(input_str, charset)
    assert isinstance(result, io.BytesIO)
    assert result.read() == input_str.encode(charset)

def test_make_input_stream_with_bytes_input():
    input_bytes = b"Hello, World!"
    charset = "utf-8"
    result = make_input_stream(input_bytes, charset)
    assert isinstance(result, io.BytesIO)
    assert result.read() == input_bytes

def test_make_input_stream_with_none_input():
    charset = "utf-8"
    result = make_input_stream(None, charset)
    assert isinstance(result, io.BytesIO)
    assert result.read() == b""

def test_make_input_stream_with_io_input():
    input_io = io.BytesIO(b"Hello, World!")
    result = make_input_stream(input_io, "utf-8")
    assert isinstance(result, io.BytesIO)
    assert result.read() == b"Hello, World!"

def test_make_input_stream_with_non_io_input():
    input_non_io = "Hello, World!"
    charset = "utf-8"
    with pytest.raises(TypeError):
        make_input_stream(input_non_io, charset)
