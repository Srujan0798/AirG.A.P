from unittest.mock import Mock
from click import Context

def test_format_message_with_param_hint():
    instance = Mock()
    instance.param_hint = "test_param"
    instance.message = "test_message"
    result = instance.format_message()
    assert result == "Invalid value for test_param: test_message"

def test_format_message_with_param():
    instance = Mock()
    instance.param = Mock()
    instance.param.get_error_hint = Mock(return_value="test_param")
    instance.ctx = Mock()
    instance.message = "test_message"
    result = instance.format_message()
    assert result == "Invalid value for test_param: test_message"

def test_format_message_without_param_or_param_hint():
    instance = Mock()
    instance.param_hint = None
    instance.param = None
    instance.message = "test_message"
    result = instance.format_message()
    assert result == "Invalid value: test_message"
```
