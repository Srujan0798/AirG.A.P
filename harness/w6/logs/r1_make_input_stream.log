You are a test-generation engineer. Write pytest unit tests for the single Python function below. Output ONLY one python code block (```python ... ```). Tests must be deterministic, use no network, no secrets. Import what you need from click. Function source:

def make_input_stream(
    input: str | bytes | t.IO[t.Any] | None, charset: str
) -> t.BinaryIO:
    # Is already an input stream.
    if hasattr(input, "read"):
        rv = _find_binary_reader(t.cast("t.IO[t.Any]", input))

        if rv is not None:
            return rv

        raise TypeError("Could not find binary reader for input stream.")

    if input is None:
        input = b""
    elif isinstance(input, str):
        input = input.encode(charset)

    return io.BytesIO(input)

=== RESPONSE ===
```python
import io
import typing as t
from click import make_input_stream

def test_make_input_stream_with_bytes():
    input_data = b"test bytes"
    charset = "utf-8"
    result = make_input_stream(input_data, charset)
    assert isinstance(result, io.BytesIO)
    assert result.read() == input_data

def test_make_input_stream_with_str():
    input_data = "test string"
    charset = "utf-8"
    result = make_input_stream(input_data, charset)
    assert isinstance(result, io.BytesIO)
    assert result.read() == input_data.encode(charset)

def test_make_input_stream_with_none():
    charset = "utf-8"
    result = make_input_stream(None, charset)
    assert isinstance(result, io.BytesIO)
    assert result.read() == b""

def test_make_input_stream_with_io():
    input_data = io.BytesIO(b"test io")
    result = make_input_stream(input_data, "utf-8")
    assert result is input_data

def test_make_input_stream_with_non_io():
    input_data = "test non io"
    charset = "utf-8"
    with pytest.raises(TypeError):
        make_input_stream(input_data, charset)
