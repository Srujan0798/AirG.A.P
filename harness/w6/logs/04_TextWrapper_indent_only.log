```python
import click

def test_indent_only():
    class MockContext:
        def __init__(self, initial_indent, subsequent_indent):
            self.initial_indent = initial_indent
            self.subsequent_indent = subsequent_indent

    ctx = MockContext(initial_indent="    ", subsequent_indent="    ")
    assert indent_only(ctx, "line1\nline2") == "    line1\n    line2"

    ctx = MockContext(initial_indent="    ", subsequent_indent="        ")
    assert indent_only(ctx, "line1\nline2") == "    line1\n        line2"

    ctx = MockContext(initial_indent="", subsequent_indent="    ")
    assert indent_only(ctx, "line1\nline2") == "line1\n    line2"

def indent_only(ctx, text: str) -> str:
    rv = []

    for idx, line in enumerate(text.splitlines()):
        indent = ctx.initial_indent

        if idx > 0:
            indent = ctx.subsequent_indent

        rv.append(f"{indent}{line}")

    return "\n".join(rv)
