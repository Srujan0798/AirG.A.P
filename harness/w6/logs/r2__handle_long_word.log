import pytest

from ._compat import _truncate_visible

class MockInstance:
    def __init__(self, break_long_words):
        self.break_long_words = break_long_words

    def _handle_long_word(
        self,
        reversed_chunks: list[str],
        cur_line: list[str],
        cur_len: int,
        width: int,
    ) -> None:
        space_left = max(width - cur_len, 1)

        if self.break_long_words:
            last = reversed_chunks[-1]
            cut = _truncate_visible(last, space_left)
            res = last[len(cut) :]
            cur_line.append(cut)
            reversed_chunks[-1] = res
        elif not cur_line:
            cur_line.append(reversed_chunks.pop())

def test_handle_long_word_break_long_words_true():
    instance = MockInstance(break_long_words=True)
    reversed_chunks = ["thisisaverylongword"]
    cur_line = []
    cur_len = 0
    width = 20
    instance._handle_long_word(reversed_chunks, cur_line, cur_len, width)
    assert reversed_chunks == ["isaverylongword"]
    assert cur_line == ["thisisavery"]

def test_handle_long_word_break_long_words_false_no_cur_line():
    instance = MockInstance(break_long_words=False)
    reversed_chunks = ["thisisaverylongword"]
    cur_line = []
    cur_len = 0
    width = 20
    instance._handle_long_word(reversed_chunks, cur_line, cur_len, width)
    assert reversed_chunks == ["thisisaverylongword"]
    assert cur_line == ["thisisaverylongword"]

def test_handle_long_word_break_long_words_false_with_cur_line():
    instance = MockInstance(break_long_words=False)
    reversed_chunks = ["thisisaverylongword"]
    cur_line = ["thisisavery"]
    cur_len = 15
    width = 20
    instance._handle_long_word(reversed_chunks, cur_line, cur_len, width)
    assert reversed_chunks == ["thisisaverylongword"]
    assert cur_line == ["thisisavery", "thisisaverylongword"]
```
