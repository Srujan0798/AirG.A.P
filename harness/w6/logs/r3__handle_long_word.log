import pytest
from click._textwrap import TextWrapper

def test_handle_long_word():
    wrapper = TextWrapper(width=10)
    reversed_chunks = ['hello', 'world']
    cur_line = []
    cur_len = 0
    wrapper.break_long_words = False

    wrapper._handle_long_word(reversed_chunks, cur_line, cur_len, 10)

    assert cur_line == ['hello']
    assert reversed_chunks == ['world']
```
