from click import wrap_text

def test_wrap_text_single_paragraph():
    """Wrap text in a single paragraph."""
    text = "This is a single paragraph that should be wrapped."
    expected = "This is a single paragraph that should be\nwrapped."
    assert wrap_text(text, width=20) == expected

def test_wrap_text_preserve_paragraphs():
    """Wrap text while preserving paragraphs."""
    text = "This is the first paragraph.\n\nThis is the second paragraph."
    expected = "This is the first paragraph.\n\nThis is the second\nparagraph."
    assert wrap_text(text, width=20, preserve_paragraphs=True) == expected

def test_wrap_text_initial_indent():
    """Wrap text with initial indent."""
    text = "This is a single paragraph that should be wrapped."
    expected = "    This is a single paragraph\n    that should be wrapped."
    assert wrap_text(text, width=20, initial_indent="    ") == expected

def test_wrap_text_subsequent_indent():
    """Wrap text with subsequent indent."""
    text = "This is a single paragraph that should be wrapped."
    expected = "This is a single paragraph\n    that should be wrapped."
    assert wrap_text(text, width=20, subsequent_indent="    ") == expected

def test_wrap_text_no_rewrap():
    """Wrap text with no rewrap."""
    text = "This is a single paragraph that should be wrapped.\n\n\\bThis is a block that should not be rewrapped."
    expected = "This is a single paragraph\n    that should be wrapped.\n\nThis is a block that should not be rewrapped."
    assert wrap_text(text, width=20, preserve_paragraphs=True) == expected
