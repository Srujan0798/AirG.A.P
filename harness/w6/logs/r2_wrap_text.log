import click
from click._compat import term_len

def test_wrap_text_single_paragraph():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "This is a single paragraph of text that should\nbe wrapped."
    assert click.formatting.wrap_text(text, width=20) == expected

def test_wrap_text_initial_indent():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "    This is a single\n    paragraph of text that should\n    be wrapped."
    assert click.formatting.wrap_text(text, width=20, initial_indent="    ") == expected

def test_wrap_text_subsequent_indent():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "This is a single\nparagraph of text that should\nbe wrapped."
    assert click.formatting.wrap_text(text, width=20, subsequent_indent="") == expected

def test_wrap_text_preserve_paragraphs():
    text = "This is a single paragraph of text that should be wrapped.\n\nThis is another paragraph."
    expected = "This is a single paragraph of text that should\nbe wrapped.\n\nThis is another paragraph."
    assert click.formatting.wrap_text(text, width=20, preserve_paragraphs=True) == expected

def test_wrap_text_preserve_paragraphs_with_raw_block():
    text = "This is a single paragraph of text that should be wrapped.\n\n\bThis is another paragraph."
    expected = "This is a single paragraph of text that should\nbe wrapped.\n\nThis is another paragraph."
    assert click.formatting.wrap_text(text, width=20, preserve_paragraphs=True) == expected
```
