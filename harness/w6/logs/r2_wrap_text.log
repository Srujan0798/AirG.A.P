import pytest
from .parser import wrap_text

def test_wrap_text_single_paragraph():
    text = "This is a single paragraph of text that should be wrapped."
    width = 20
    expected = "This is a single\nparagraph of text that\nshould be wrapped."
    assert wrap_text(text, width) == expected

def test_wrap_text_preserve_paragraphs():
    text = "This is the first paragraph.\n\nThis is the second paragraph.\n\nThis is the third paragraph."
    width = 20
    expected = "This is the first\nparagraph.\n\nThis is the second\nparagraph.\n\nThis is the third\nparagraph."
    assert wrap_text(text, width, preserve_paragraphs=True) == expected

def test_wrap_text_initial_indent():
    text = "This is a single paragraph of text that should be wrapped."
    width = 20
    initial_indent = "    "
    expected = "    This is a\n    single paragraph\n    of text that\n    should be\n    wrapped."
    assert wrap_text(text, width, initial_indent=initial_indent) == expected

def test_wrap_text_subsequent_indent():
    text = "This is a single paragraph of text that should be wrapped."
    width = 20
    subsequent_indent = "    "
    expected = "This is a\n    single paragraph\n    of text that\n    should be\n    wrapped."
    assert wrap_text(text, width, subsequent_indent=subsequent_indent) == expected

def test_wrap_text_no_rewrap_in_block():
    text = "\bThis is a single paragraph of text that should not be rewrapped."
    width = 20
    expected = "This is a single\nparagraph of text that\nshould not be rewrapped."
    assert wrap_text(text, width, preserve_paragraphs=True) == expected
