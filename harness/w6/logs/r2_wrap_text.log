from click.formatting import wrap_text

def test_wrap_text_basic():
    """Basic wrapping without paragraphs."""
    result = wrap_text("This is a simple sentence that should be wrapped.", width=20)
    assert result == "This is a simple\nsentence that should be\nwrapped."

