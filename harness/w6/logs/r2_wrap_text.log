from click.formatting import wrap_text

def test_wrap_text_basic():
    """Basic wrapping without initial or subsequent indent."""
    result = wrap_text("This is a simple sentence that should be wrapped.", width=20)
    assert result == "This is a simple\nsentence that should\nbe wrapped."

def test_wrap_text_initial_indent():
    """Wrapping with an initial indent."""
    result = wrap_text("This is a simple sentence that should be wrapped.", width=20, initial_indent="    ")
    assert result == "    This is a\n    simple sentence\n    that should\n    be wrapped."

def test_wrap_text_subsequent_indent():
    """Wrapping with a subsequent indent."""
    result = wrap_text("This is a simple sentence that should be wrapped.", width=20, subsequent_indent="    ")
    assert result == "This is a simple\nsentence that should\nbe wrapped."

def test_wrap_text_raw_paragraph():
    """Wrapping with a raw paragraph."""
    result = wrap_text("This is the first paragraph.\n\n\bThis is the second paragraph.", preserve_paragraphs=True)
    assert result == "This is the first paragraph.\n\nThis is the second paragraph."

def test_wrap_text_preserve_paragraphs():
    """Wrapping with preserve_paragraphs enabled."""
    result = wrap_text("This is the first paragraph.\n\nThis is the second paragraph.", preserve_paragraphs=True)
    assert result == "This is the first paragraph.\n\nThis is the second paragraph."
```
