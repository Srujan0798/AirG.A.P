import click
from click._textwrap import TextWrapper
from click._compat import term_len

def test_wrap_text_single_paragraph():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "This is a single paragraph of text that should\nbe wrapped."
    assert click.formatting.wrap_text(text) == expected

def test_wrap_text_preserve_paragraphs():
    text = "This is the first paragraph.\n\nThis is the second paragraph."
    expected = "This is the first paragraph.\n\nThis is the second paragraph."
    assert click.formatting.wrap_text(text, preserve_paragraphs=True) == expected

def test_wrap_text_initial_indent():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "    This is a single paragraph of text that should\n    be wrapped."
    assert click.formatting.wrap_text(text, initial_indent="    ") == expected

def test_wrap_text_subsequent_indent():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "This is a single paragraph of text that should\nbe wrapped."
    assert click.formatting.wrap_text(text, subsequent_indent=" ") == expected

def test_wrap_text_width():
    text = "This is a single paragraph of text that should be wrapped."
    expected = "This is a single paragraph of text that should\nbe wrapped."
    assert click.formatting.wrap_text(text, width=20) == expected

def test_wrap_text_empty_paragraph():
    text = "This is the first paragraph.\n\nThis is the second paragraph."
    expected = "This is the first paragraph.\n\nThis is the second paragraph."
    assert click.formatting.wrap_text(text, preserve_paragraphs=True) == expected

def test_wrap_text_raw_paragraph():
    text = "\bThis is a raw paragraph that should not be wrapped."
    expected = "\bThis is a raw paragraph that should not be wrapped."
    assert click.formatting.wrap_text(text, preserve_paragraphs=True) == expected
