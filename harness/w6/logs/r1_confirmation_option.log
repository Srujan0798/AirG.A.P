import pytest
from click import Context, Parameter, option
from click.testing import CliRunner
from click.types import BOOL

def test_confirmation_option():
    runner = CliRunner()

    @confirmation_option()
    def my_command(ctx):
        return "Confirmed"

    result = runner.invoke(my_command, ["--yes"])
    assert result.exit_code == 0
    assert result.output == "Confirmed\n"

    result = runner.invoke(my_command)
    assert result.exit_code == 1
    assert "Do you want to continue?" in result.output
