```python
from click import Parameter, Context
from typing import Any
import pytest
import types

def test_convert_no_conversion():
    class TestConverter:
        def convert(self, value: Any, param: Parameter | None, ctx: Context | None) -> Any:
            return super().convert(value, param, ctx)

    converter = TestConverter()
    assert converter.convert(123, None, None) == 123
    assert converter.convert("123", None, None) == "123"
    assert converter.convert(None, None, None) is None

def test_convert_subclass_customization():
    class CustomConverter:
        def convert(self, value: Any, param: Parameter | None, ctx: Context | None) -> Any:
            if isinstance(value, str):
                return int(value)
            return super().convert(value, param, ctx)

    converter = CustomConverter()
    assert converter.convert("123", None, None) == 123
    assert converter.convert(123, None, None) == 123
    assert converter.convert(None, None, None) is None

def test_convert_fail_on_invalid_type():
    class TestConverter:
        def convert(self, value: Any, param: Parameter | None, ctx: Context | None) -> Any:
            if not isinstance(value, str):
                self.fail(f"Invalid type: {type(value)}")
            return super().convert(value, param, ctx)

    converter = TestConverter()
    with pytest.raises(SystemExit) as exc_info:
        converter.convert(123, None, None)
    assert exc_info.value.code == 2
    assert "Invalid type: <class 'int'>" in str(exc_info.value)

    with pytest.raises(SystemExit) as exc_info:
        converter.convert(None, None, None)
    assert exc_info.value.code == 2
    assert "Invalid type: <class 'NoneType'>" in str(exc_info.value)
