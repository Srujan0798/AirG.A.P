import pytest
from click._textwrap import TextWrapper
from click.utils import term_len

def test_wrap_text_single_paragraph():
    result = wrap_text("This is a single paragraph of text that should be wrapped.")
    assert result == "This is a single paragraph of text that should be\nwrapped."

def test_wrap_text_preserve_paragraphs():
    result = wrap_text("This is the first paragraph.\n\nThis is the second paragraph.", preserve_paragraphs=True)
    assert result == "This is the first paragraph.\n\nThis is the second\nparagraph."

def test_wrap_text_initial_indent():
    result = wrap_text("This is a single paragraph of text that should be wrapped.", initial_indent="    ")
    assert result == "    This is a single paragraph of text that\n    should be wrapped."

def test_wrap_text_subsequent_indent():
    result = wrap_text("This is a single paragraph of text that should be wrapped.", subsequent_indent="    ")
    assert result == "This is a single paragraph of text that\n    should be wrapped."

def test_wrap_text_no_rewrap():
    result = wrap_text("This is a single paragraph of text that should be wrapped.\n\n\bThis is a block that should not be rewrapped.", preserve_paragraphs=True)
    assert result == "This is a single paragraph of text that\n    should be wrapped.\n\nThis is a block that should not be rewrapped."
